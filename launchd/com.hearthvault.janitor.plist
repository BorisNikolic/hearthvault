<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hearthvault.janitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>mkdir -p "$HOME/.claude/logs" &amp;&amp; cd "__VAULT__" &amp;&amp; claude -p "/vault-cleanup" --permission-mode acceptEdits</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>1</integer>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>7</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.claude/logs/hearthvault-janitor.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/logs/hearthvault-janitor.log</string>
</dict>
</plist>
